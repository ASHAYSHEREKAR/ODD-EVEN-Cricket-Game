{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "cricket_backend/**",
      "tests/**",
      ".agents/**"
    ],
    "headers": [
      {
        "source": "**/*.@(css|js|png|jpg|svg|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
