  "cards": [
    {
      "dot": "emerald",
      "title": "Primary Gameplay & Ball Accounting Path",
      "items": [
        "Evaluates shot timing window (-50ms to +50ms) to resolve runs (0, 1, 2, 4, 6) or dismissal",
        "Even/Odd bank formula grants +1 ball (Preferred), 0 (Neutral), or -1 ball (Unpreferred)",
        "3-strike penalty deducts an extra ball on consecutive non-preferred runs to enforce strategy"
      ]
    },
    {
      "dot": "cyan",
      "title": "2.5D Pitch Rendering & Procedural Physics",
      "items": [
        "Projects 3D trajectory to 2.5D vanishing plane: Scale(Y) = 0.55 + 0.55 * Y_progress",
        "Real-time procedural physics models seam, In-Swinger, Out-Swinger, and Googly spin",
        "60 FPS animation loop renders bat swing arcs, ball impact, and wicket stumps"
      ]
    },
    {
      "dot": "violet",
      "title": "P2P WebRTC Multiplayer Synchronization",
      "items": [
        "PeerJS cloud broker performs STUN and signaling handshake between players",
        "Low-latency WebRTC DataChannel synchronizes coin toss, delivery triggers, and batting actions",
        "Host acts as authoritative local arbiter; requires zero backend match database"
      ]
    },
    {
      "dot": "rose",
      "title": "Security, Isolation & Edge Delivery",
      "items": [
        "Zero-backend client model: no user credentials or server database to compromise",
        "Origin-isolated LocalStorage protects high scores, sound preferences, and player alias",
        "Firebase Hosting delivers versioned PWA assets with immutable cache control headers"
      ]
    }
  ]
